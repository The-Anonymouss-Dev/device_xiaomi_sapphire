// Device modes for the libperfmgr power HAL: double tap to wake and the
// KProfiles switch (persist.vendor.kprofile.mode)
cc_library_static {
    name: "libperfmgr-ext-sapphire",
    defaults: [
        "android.hardware.power-ndk_shared",
    ],
    vendor: true,
    srcs: [
        "power-mode.cpp",
    ],
    shared_libs: [
        "libbase",
        "libperfmgr",
        "libutils",
    ],
    // Headers that perfmgr/HintManager.h pulls in
    static_libs: [
        "powerhal_flags-aconfig-cc",
    ],
}
