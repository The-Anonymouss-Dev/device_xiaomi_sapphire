# Allow hal_power_default to write to dt2w nodes
allow hal_power_default input_device:dir r_dir_perms;
allow hal_power_default input_device:chr_file rw_file_perms;
allow hal_power_default proc_tp_gesture:dir search;
allow hal_power_default proc_tp_gesture:file rw_file_perms;
allow hal_power_default proc_walt:file rw_file_perms;
allow hal_power_default proc_walt:dir search;

# Power HAL needs access to CPU DMA latency
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# Power HAL boost permissions  
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default sysfs_devices_system_cpu:dir search;

r_dir_file(hal_power_default, input_device)

allow hal_power_default {
  cgroup
  proc
}:{
  file
  lnk_file
} rw_file_perms;

# Allow Power HAL to query Qualcomm display config HAL
hal_client_domain(hal_power_default, hal_graphics_composer)
binder_call(hal_power_default, hal_graphics_composer_default)

# powerhint.json nodes: GPU devfreq limits
allow hal_power_default vendor_sysfs_kgsl:dir search;
allow hal_power_default vendor_sysfs_kgsl:file rw_file_perms;

# ADPF hint sessions set uclamp on the threads of the session owner
allow hal_power_default self:global_capability_class_set sys_nice;

# KProfiles: the profile chosen in Settings
get_prop(hal_power_default, vendor_kprofile_prop)
