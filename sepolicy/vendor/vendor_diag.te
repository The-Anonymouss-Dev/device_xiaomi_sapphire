# Domain for diag-router service
# Fixes: diag-router has no domain transition from init
# avc: denied (no domain transition from u:r:init:s0)
init_daemon_domain(vendor_diag)

# Allow diag-router to create and use netlink uevent socket
# Fixes: avc: denied { create } for comm="diag-router" scontext=u:r:vendor_diag:s0 tcontext=u:r:vendor_diag:s0 tclass=netlink_kobject_uevent_socket
allow vendor_diag self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;


# The socket rule above is not enough: diag-router then dies on the next
# denials below, exits with status 1 and init restarts it every 5 s, which
# also runs flags_health_check UPDATABLE_CRASHING on every restart.
# qipcrtr: talking to the remote processors over QRTR.
allow vendor_diag self:qipcrtr_socket create_socket_perms;
# Only the msm_sock_ipc ioctls, as the vendor policy does for QRTR users;
# an unrestricted ioctl would trip the socket ioctl neverallowxperm.
allowxperm vendor_diag self:qipcrtr_socket ioctl { 0xc300-0xc305 };
# functionfs: it looks for the USB diag function at start.
allow vendor_diag functionfs:dir r_dir_perms;
# It reads the hwservicemanager ready prop while waiting for HALs.
get_prop(vendor_diag, hwservicemanager_prop)
