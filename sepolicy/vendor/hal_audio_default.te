allow hal_audio_default debugfs:dir read;

# Allow audio HAL to write to pipes passed by apps (dump/log fds)
allow hal_audio_default untrusted_app_all:fifo_file write;

# The audio HAL retries Qualcomm diag (QXDM logging) every second for a
# few minutes after it starts; that is only for lab debugging, so do not
# grant it, just keep the denials out of the log.
dontaudit hal_audio_default vendor_diag:unix_stream_socket connectto;
