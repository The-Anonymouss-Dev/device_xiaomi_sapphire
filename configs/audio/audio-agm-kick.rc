# The ADSP is booted at early-boot and its firmware is loaded by ueventd
# behind the modem/CDSP/GPU images, so it comes up 7 s or more later, about
# when the audio HAL runs AGM init (the HAL is started by class hal and
# again by audioserver.rc as soon as audioserver runs, so it cannot simply
# be held back). AGM gives the DSP about 7 s in gsl_init(); when that runs
# out AGM init fails, IAGM is never registered and the HAL blocks forever
# in getService(IAGM). audioserver and then system_server block behind it
# until the watchdog restarts system_server.
#
# While the HAL waits for IAGM, hwservicemanager asks init every second to
# start the service declaring it. Declare it here on a helper that waits
# for the ADSP to run and exits; then restart the HAL, whose AGM init now
# finds the DSP. Boots where AGM comes up are not touched.
#
# Imported from init.xiaomi.rc and kept out of /vendor/etc/init: the
# build's host_init_verifier only knows interfaces built from a
# hidl_interface module, and AGMIPC@1.0 comes as a prebuilt blob here.
service vendor.audio-agm-kick /vendor/bin/vendor.adsp-wait.sh 0
    interface vendor.qti.hardware.AGMIPC@1.0::IAGM default
    user root
    group root
    seclabel u:r:vendor_qti_init_shell:s0
    oneshot
    disabled

on property:init.svc.vendor.audio-agm-kick=stopped
    restart vendor.audio-hal
