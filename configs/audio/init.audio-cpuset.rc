# Audio on the gold cores, as on HyperOS.
#
# Left on the silver cores, the audio HAL's writer and Dolby threads
# sometimes stall for 6-8 ms, longer than a fast mixer period (5 ms), and
# the sound crackles in games and when notifications pile up. On the gold
# cores the longest mix cycle measured was 6 ms with no underruns.
#
# This lives in system_ext, not in a vendor rc: vendor_init cannot use the
# init.svc.* triggers or read the init.svc_debug_pid.* properties, so the
# same lines in init.xiaomi.rc never ran.
on init
    mkdir /dev/cpuset/audio-app
    copy /dev/cpuset/mems /dev/cpuset/audio-app/mems
    write /dev/cpuset/audio-app/cpus 4-7

on property:init.svc.audioserver=running
    write /dev/cpuset/audio-app/cgroup.procs ${init.svc_debug_pid.audioserver}

on property:init.svc.vendor.audio-hal=running
    write /dev/cpuset/audio-app/cgroup.procs ${init.svc_debug_pid.vendor.audio-hal}
